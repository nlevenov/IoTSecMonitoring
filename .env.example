# Copy to .env, fill in, and keep it out of version control.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# capture
IOTSEC_INTERFACE=eth0
IOTSEC_NETWORKS=192.168.1.0/24
IOTSEC_GATEWAY=192.168.1.1

# signs the trained model so a tampered file is never loaded
IOTSEC_MODEL_KEY=

# dashboard: output of `iotsec hash-password` (keep the single quotes)
IOTSEC_DASHBOARD_PASSWORD_HASH=''
# host names used to reach the dashboard (comma separated)
IOTSEC_ALLOWED_HOSTS=localhost,127.0.0.1

# e-mail alerts (TLS only: ssl = implicit TLS on 465, starttls on 587)
IOTSEC_SMTP_ENABLED=false
IOTSEC_SMTP_HOST=
IOTSEC_SMTP_PORT=465
IOTSEC_SMTP_SECURITY=ssl
IOTSEC_SMTP_USER=
IOTSEC_SMTP_PASSWORD=
IOTSEC_SMTP_SENDER=
IOTSEC_SMTP_RECIPIENTS=

# Slack / Mattermost / Teams incoming webhook (https only)
IOTSEC_WEBHOOK_URL=
